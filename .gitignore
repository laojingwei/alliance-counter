# ---- 依赖（仅测试脚本需要，不进版本库）----
node_modules/
package-lock.json
npm-debug.log*

# ---- 本地缓存 / 系统文件 ----
.npm-cache/
.DS_Store
Thumbs.db
desktop.ini

# ---- 编辑器 ----
.vscode/
.idea/
*.swp

# ---- 含真实数据的文件，不要提交 ----
# 未脱敏的原始战报表
原始战报*.csv
raw/
private/
# 用户导入的真实全量数据（50MB+，含真实玩家/同盟名）
samples/real_*.csv
# 页面「导出存档」产生的文件（含真实同盟/玩家名）
战报累计存档_*.json
*.battle-backup.json

# ---- 临时产物 ----
*.tmp
*.log
tools/shots/

dist/


# 编辑 CSV 时编辑器留下的备份
*.csvbk
*.csv.bak


# ---- Sanmou 战报数据（sanmou-viewer 导出）----
# 已脱敏（玩家→玩家0001…、同盟→同盟001…），入库以便 Pages 开箱可用；
# 数据按 25 MiB 上限分片（Cloudflare Pages 单文件上限），由 tools/split-battle-data.mjs 生成。
# 要改成「不进仓库」就取消下面两行注释，并同步 README 里的数据源说明
# js/battle-data.js
# js/battle-data.*.js
